<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Promise OJ — Video Portfolio</title>
  <style>
    :root {
      --bg: #0f172a;
      --text: #e2e8f0;
      --accent: #38bdf8;
      font-family: "Inter", system-ui, sans-serif;
    }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
    }
    header {
      text-align: center;
      padding: 60px 20px 20px;
    }
    header h1 {
      font-size: 2rem;
      margin-bottom: 8px;
    }
    header p {
      color: #94a3b8;
    }
    section {
      max-width: 900px;
      margin: 0 auto;
      padding: 20px;
    }
    h2 {
      border-left: 4px solid var(--accent);
      padding-left: 10px;
      margin-top: 40px;
    }
    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
    iframe {
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 0;
      border-radius: 10px;
    }
    footer {
      text-align: center;
      padding: 30px 0;
      color: #94a3b8;
      font-size: 0.9rem;
    }
    a {
      color: var(--accent);
      text-decoration: none;
    }
  </style>
</head>
<body>

  <header>
    <h1>Promise OJ</h1>
    <p>Web3 Video Content Creator & Motion Designer</p>
  </header>

  <section>
    <h2>🎥 My Works</h2>
    <div class="video-grid">
      <iframe src="https://https://x.com/promise_oj/status/1906044897053868135" title="Project 1"></iframe>
      <iframe src="https://https://x.com/promise_oj/status/1963643978898968764" title="Project 2"></iframe>
      <iframe src="https://https://x.com/promise_oj/status/1973424625095995851" title="Project 3"></iframe>
    </div>

    <h2>👋 About Me</h2>
    <p>
      I’m Promise, a Web3-focused video creator and motion designer helping crypto projects tell stories that captivate, educate, and convert. 
      I specialize in explainer videos, stomp typography, and storytelling-driven motion content.
    </p>

    <h2>📩 Contact</h2>
    <p>
      <a href="https://x.com/promise_oj">Twitter</a> • 
      <a href="mailto:0xpromise091@gmail.com">Email</a> • 
      <a href="https://www.youtube.com/@promiseoj">YouTube</a>
    </p>
  </section>

  <footer>
    © <span id="year"></span> Promise OJ. All Rights Reserved.
  </footer>

  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>

</body>
</html>
